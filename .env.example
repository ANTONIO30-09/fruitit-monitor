APP_NAME=fruit-bird-detector
APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
CAPTURE_SOURCE=file
CAPTURE_WEBCAM_INDEX=0
CAPTURE_IP_URL=http://192.168.1.100:8080/video
CAPTURE_FILE_PATH=./data/sample.mp4
CAPTURE_FPS=5
MODEL_BIRDS_PATH=./models/birds.onnx
MODEL_BIRDS_CONF=0.35
MODEL_FRUITS_PATH=./models/fruits.onnx
MODEL_FRUITS_CONF=0.35
PROXIMITY_OVERLAP_THRESHOLD=0.15
ACTIVE_FRUIT_PROFILE=manzana
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
